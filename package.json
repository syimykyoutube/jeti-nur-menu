{
  "name": "jeti-nur-menu",
  "version": "0.0.0",
  "private": true,
  "description": "Жети Нур Меню — Cloudflare Workers жана Hono негизиндеги меню",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2",
    "secrets:local": "node scripts/init-local-secrets.ts",
    "db:migrate:local": "wrangler d1 migrations apply jeti-nur-menu --local",
    "menu:rebuild:local": "node scripts/rebuild-local.ts",
    "demo:local": "node scripts/menu-benchmark.ts"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "jsqr": "^1.4.0",
    "miniflare": "5.20261012.0-beta",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
